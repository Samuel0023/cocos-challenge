          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (side, type) (increase(orders_total[$__range])) > 0",
          "legendFormat": "{{side}} {{type}}",
          "instant": true

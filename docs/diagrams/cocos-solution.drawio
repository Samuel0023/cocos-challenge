        <mxCell id="cancel-title" value="Flujo: cancelar orden (POST /orders/:orderId/cancel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cancel-subtitle" value="Cada color indica el componente que ejecuta el paso. Solo una orden en estado NEW puede pasar a CANCELLED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cancel-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Controlador Express&lt;/i&gt;&lt;br&gt;Recibir POST /orders/:orderId/cancel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="360" height="60" as="geometry" />

  <diagram id="cancel" name="Flow: cancel order">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cancel-title" value="Flow: cancel order (POST /orders/:orderId/cancel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cancel-subtitle" value="Each color shows the component that runs the step. Only an order in NEW status can become CANCELLED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cancel-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;Receive POST /orders/:orderId/cancel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancel-find" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderRepository&lt;/i&gt;&lt;br&gt;Read the order to find the user who owns it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="230" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancel-exists" value="&lt;i style=&quot;font-size:10px&quot;&gt;CancelOrder (use case)&lt;/i&gt;&lt;br&gt;Does the order exist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="340" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cancel-e404" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;404 Not Found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancel-n_idem" value="No Idempotency-Key: a second cancel answers 409, because the order is no longer NEW." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cancel-tx" value="Transaction" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;;;dashed=1;strokeColor=#6c8ebf;fontColor=#1f3a5f;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="820" height="620" as="geometry" />
        </mxCell>
        <mxCell id="cancel-publish" value="&lt;i style=&quot;font-size:10px&quot;&gt;EventPublisher (SNS)&lt;/i&gt;&lt;br&gt;Publish order.cancelled event to Amazon SNS&lt;br&gt;(after COMMIT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="340" y="1210" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cancel-ok" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;200 OK with the order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="1340" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancel-note" value="The reservation of pesos or shares is released automatically: it is derived from orders in NEW." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="1210" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cancel-fleg" value="Components" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1200" y="110" width="300" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cancel-begin" value="&lt;i style=&quot;font-size:10px&quot;&gt;UnitOfWork&lt;/i&gt;&lt;br&gt;BEGIN + lock on the user who owns the order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="cancel-tx">

        <mxCell id="search-query" value="&lt;i style=&quot;font-size:10px&quot;&gt;InstrumentSearchRepository&lt;/i&gt;&lt;br&gt;Query instruments with unaccent(ticker or name) ILIKE unaccent('%q%')&lt;br&gt;(case- and accent-insensitive)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

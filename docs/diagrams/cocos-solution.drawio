        <mxCell id="local-a_pg" value="postgres&lt;br&gt;PostgreSQL 16, publicado en 127.0.0.1:5432&lt;br&gt;se inicializa con database.sql y migrations/001_constraints_indexes.sql" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="local-a_compose">

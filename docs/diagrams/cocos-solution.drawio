  <diagram id="consumer" name="Flow: event consumer">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="consumer-title" value="Flow: event consumer (queue order-events-queue)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="consumer-subtitle" value="Each color shows the component that runs the step. Asynchronous loop inside the same API process; SQS delivers at least once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="consumer-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;cocos-api process&lt;/i&gt;&lt;br&gt;API process startup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="consumer-en" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;AWS_ENABLED and CONSUMER_ENABLED = true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="500" y="230" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="consumer-off" value="&lt;i style=&quot;font-size:10px&quot;&gt;cocos-api process&lt;/i&gt;&lt;br&gt;The consumer does not start; the API only serves HTTP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="960" y="260" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-n_loop" value="No worker_thread: the work is I/O-bound. If it ever slows the API, it moves to a separate process." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-recv" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;ReceiveMessage on order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-msgs" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;Did messages arrive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="500" y="550" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="consumer-parse" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;Parse the event: eventId and type&lt;br&gt;(order.created / order.cancelled)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="460" y="700" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-rec" value="&lt;i style=&quot;font-size:10px&quot;&gt;RecordOrderEvent (use case)&lt;/i&gt;&lt;br&gt;Record the event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="830" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="consumer-ins" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderEventStore (PostgreSQL)&lt;/i&gt;&lt;br&gt;INSERT INTO analytics.order_events ... ON CONFLICT (event_id) DO NOTHING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="940" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-n_ins" value="Unique key on event_id: a repeated event stores nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-ok" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;Parse and store without error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="500" y="1070" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="consumer-fail" value="&lt;i style=&quot;font-size:10px&quot;&gt;SQS event consumer&lt;/i&gt;&lt;br&gt;The message is not deleted: SQS delivers it again later" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">

<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="build_drawio_en.py" version="24.7.17" type="device">
  <diagram id="hex" name="Hexagonal architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hex-title" value="Hexagonal architecture of the API: dependencies point toward the domain" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hex-subtitle" value="Adapters depend on ports; the application and the domain know nothing about Express, PostgreSQL, Valkey or AWS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hex-outer" value="API cocos-api" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="1720" height="1360" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_pg" value="PostgreSQL&lt;br&gt;public and analytics schemas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2160" y="210" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_valkey" value="Valkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="2160" y="510" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_sns" value="Amazon SNS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="2160" y="630" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_sqs" value="Amazon SQS&lt;br&gt;queue order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hex-folders" value="Code in two groups: src/modules holds the features (orders, portfolio, instruments, marketdata, order-events); src/platform holds the technical pieces. platform never imports from modules." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1530" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hex-credsnote" value="The database credential is always read from environment variables: there is no secrets port." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

        <mxCell id="search-norm" value="&lt;i style=&quot;font-size:10px&quot;&gt;Zod validation&lt;/i&gt;&lt;br&gt;Normalize q (trim, lowercase) and limit (default 20, maximum 100)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="440" height="80" as="geometry" />

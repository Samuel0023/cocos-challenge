          <mxGeometry x="20" y="280" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="search-fl_rh" value="" style="rhombus;whiteSpace=wrap;html=1;;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="search-fleg">
          <mxGeometry x="20" y="320" width="60" height="40" as="geometry" />

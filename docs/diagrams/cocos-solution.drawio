        </mxCell>
        <mxCell id="aws-api" value="API HTTP (Express)&lt;br&gt;GET /users/:userId/portfolio&lt;br&gt;GET /instruments&lt;br&gt;POST /orders&lt;br&gt;POST /orders/:orderId/cancel&lt;br&gt;GET /metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="aws-proc">
          <mxGeometry x="20" y="40" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="aws-consumer" value="Event consumer&lt;br&gt;SQS long-polling loop&lt;br&gt;enabled with CONSUMER_ENABLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="aws-proc">
          <mxGeometry x="20" y="380" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-client" target="aws-alb">

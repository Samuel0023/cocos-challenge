        </mxCell>
        <mxCell id="hex-x_pg" value="PostgreSQL&lt;br&gt;public and analytics schemas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

        <mxCell id="search-ok" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;200 OK with the paginated list&lt;br&gt;(empty list if nothing matches)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">

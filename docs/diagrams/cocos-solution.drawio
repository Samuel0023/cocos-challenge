  <diagram id="portfolio" name="Flujo: portfolio">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="portfolio-title" value="Flujo: portfolio (GET /users/:userId/portfolio)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-subtitle" value="Cada color indica el componente que ejecuta el paso. Saldos y posiciones se derivan de las órdenes FILLED; las reservas de LIMIT en NEW se restan del disponible." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Controlador Express&lt;/i&gt;&lt;br&gt;Recibir GET /users/:userId/portfolio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-exists" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (caso de uso) + AccountReader&lt;/i&gt;&lt;br&gt;¿Existe el usuario?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-e404" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;404 Not Found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-cash" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Consultar pesos: suma de órdenes FILLED&lt;br&gt;(CASH_IN + SELL × price − CASH_OUT − BUY × price)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-avail" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Restar reservas (LIMIT BUY en NEW: size × price)&lt;br&gt;= pesos disponibles" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="550" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-pos" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Consultar posiciones por instrumento:&lt;br&gt;cantidad neta de órdenes FILLED (BUY − SELL)&lt;br&gt;costo promedio ponderado de las compras FILLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="680" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-drop" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (caso de uso)&lt;/i&gt;&lt;br&gt;Descartar posiciones con cantidad ≤ 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="830" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-mdc" value="&lt;i style=&quot;font-size:10px&quot;&gt;Cache (Valkey)&lt;/i&gt;&lt;br&gt;Leer en Valkey el último close y previousClose por instrumento (TTL 60 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="330" y="940" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-md" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;Si no está o Valkey falla: leerlos de marketdata y guardarlos en Valkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="1070" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-calc" value="&lt;i style=&quot;font-size:10px&quot;&gt;PositionValuation (dominio, con Money)&lt;/i&gt;&lt;br&gt;Calcular por posición:&lt;br&gt;valor de mercado = cantidad × close&lt;br&gt;rendimiento total % = (close − costo promedio) / costo promedio&lt;br&gt;retorno diario % = (close − previousClose) / previousClose" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="1200" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-total" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (caso de uso)&lt;/i&gt;&lt;br&gt;Valor total = saldo en pesos + suma de valores de mercado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="1370" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-ok" value="&lt;i style=&quot;font-size:10px&quot;&gt;Controlador Express&lt;/i&gt;&lt;br&gt;200 OK con totalValue, availableCash, positions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1480" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-note" value="Resultado esperado para el usuario 1:&lt;br&gt;saldo 753.000,00; disponible 627.500,00; PAMP 40, METR 500; valor total 904.784,00" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

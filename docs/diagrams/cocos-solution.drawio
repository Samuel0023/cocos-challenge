        <mxCell id="aws-sqs" value="Amazon SQS&lt;br&gt;cola order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1580" y="420" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-secrets" value="AWS Secrets Manager&lt;br&gt;credencial de la base" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-secnote" value="ECS la inyecta desde la task definition. La API nunca llama a Secrets Manager: siempre lee la credencial de variables de entorno." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

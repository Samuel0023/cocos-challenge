          <mxGeometry x="80" y="270" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cancel-e409" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;409 Conflict&lt;br&gt;(only NEW orders can be cancelled)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="cancel-tx">
          <mxGeometry x="500" y="280" width="280" height="80" as="geometry" />

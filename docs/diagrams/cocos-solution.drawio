        <mxCell id="aws-api" value="API HTTP (Express)&lt;br&gt;GET /users/:userId/portfolio&lt;br&gt;GET /instruments&lt;br&gt;POST /orders&lt;br&gt;POST /orders/:orderId/cancel&lt;br&gt;GET /metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="aws-proc">

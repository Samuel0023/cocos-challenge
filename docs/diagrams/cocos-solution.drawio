          <mxGeometry x="20" y="160" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-fl4" value="SNS adapter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="portfolio-fleg">

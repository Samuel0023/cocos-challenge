  <diagram id="local" name="Local environment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="local-title" value="The API always calls the emulator at 127.0.0.1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="local-subtitle" value="The AWS Emulator self-signed certificate only covers localhost, 127.0.0.1 and ::1; so no container calls it as https://aws-emulator:9297." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-laneA" value="Development mode: make services + make dev" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1400" height="660" as="geometry" />
        </mxCell>
        <mxCell id="local-laneB" value="Full mode: make up (compose.aws.yaml)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1500" y="110" width="1380" height="780" as="geometry" />
        </mxCell>
        <mxCell id="local-cmds_band" value="Commands (Makefile)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="local-tests" value="Tests (Vitest + Supertest)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1020" y="990" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="local-testpg" value="Disposable PostgreSQL (Testcontainers)&lt;br&gt;never the shared Neon database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1400" y="980" width="340" height="100" as="geometry" />

        <mxCell id="local-legend" value="Legend" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1820" y="950" width="380" height="260" as="geometry" />
        </mxCell>
        <mxCell id="local-a_api" value="cocos-api API (Node.js on the host), port 3000&lt;br&gt;started with make dev&lt;br&gt;reads the database credential from environment variables" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="local-laneA">
          <mxGeometry x="40" y="60" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="local-a_vol" value="Volume ~/.aws/emulator/9297&lt;br&gt;credentials and ca.pem, regenerated on every start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="local-laneA">
          <mxGeometry x="860" y="60" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="local-a_compose" value="Docker Compose (make services)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="local-laneA">
          <mxGeometry x="40" y="190" width="1320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="local-b_dev" value="Developer / reviewer&lt;br&gt;(Postman or REST Client)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="local-laneB">
          <mxGeometry x="480" y="60" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="local-b_vol" value="Volume ~/.aws/emulator/9297&lt;br&gt;credentials and ca.pem, regenerated on every start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="local-laneB">
          <mxGeometry x="780" y="60" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="local-b_compose" value="Docker Compose (make up)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="local-laneB">
          <mxGeometry x="40" y="190" width="1300" height="540" as="geometry" />
        </mxCell>
        <mxCell id="local-cmds" value="make services — Starts PostgreSQL, Valkey, AWS Emulator, aws-init, Prometheus and Grafana in Docker&lt;br&gt;make dev — Runs the API on the host with Node, against those services&lt;br&gt;make up — Starts everything in Docker, API included, with compose.aws.yaml&lt;br&gt;make test — Runs the unit and functional tests&lt;br&gt;make lint — Runs ESLint and the Prettier format check&lt;br&gt;make down — Stops the containers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="local-cmds_band">
          <mxGeometry x="20" y="50" width="860" height="140" as="geometry" />
        </mxCell>
        <mxCell id="local-lg0" value="API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="local-legend">
          <mxGeometry x="20" y="40" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-lg1" value="Database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="local-legend">
          <mxGeometry x="20" y="80" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-lg2" value="Cache (Valkey)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="local-legend">
          <mxGeometry x="20" y="120" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-lg3" value="AWS services (emulated)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="local-legend">
          <mxGeometry x="20" y="160" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-lg4" value="External actors, volume, tests and metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="local-legend">
          <mxGeometry x="20" y="200" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="local-a_pg" value="postgres&lt;br&gt;PostgreSQL 16, published on 127.0.0.1:5432&lt;br&gt;initialized with database.sql and migrations/001_constraints_indexes.sql" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="local-a_compose">
          <mxGeometry x="20" y="60" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="local-a_valkey" value="valkey&lt;br&gt;published on 127.0.0.1:6379&lt;br&gt;price and search cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="local-a_compose">
          <mxGeometry x="340" y="60" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="local-a_emu" value="aws-emulator&lt;br&gt;AWS Emulator, image built from the Dockerfile in the AWS documentation&lt;br&gt;HTTPS with self-signed certificate&lt;br&gt;in-memory state&lt;br&gt;published on 127.0.0.1:9297" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="local-a_compose">
          <mxGeometry x="600" y="60" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="local-a_init" value="aws-init&lt;br&gt;one-shot AWS CLI&lt;br&gt;creates the order-events topic, the order-events-queue queue and the subscription&lt;br&gt;network_mode: service:aws-emulator, calls https://127.0.0.1:9297" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="local-a_compose">
          <mxGeometry x="1020" y="60" width="280" height="160" as="geometry" />
        </mxCell>

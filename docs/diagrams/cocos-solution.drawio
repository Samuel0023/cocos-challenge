        <mxCell id="local-title" value="La API siempre llama al emulador en 127.0.0.1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="local-subtitle" value="El certificado autofirmado de AWS Emulator solo cubre localhost, 127.0.0.1 y ::1; por eso ningún contenedor lo llama como https://aws-emulator:9297." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />

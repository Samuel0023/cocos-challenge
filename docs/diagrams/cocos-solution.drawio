  <diagram id="submit" name="Flujo: enviar orden">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="submit-title" value="Flujo: enviar orden (POST /orders)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="submit-subtitle" value="Cada color indica el componente que ejecuta el paso. Las validaciones previas no graban nada; la decisión de fondos y la inserción ocurren en una única transacción." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="submit-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Controlador Express&lt;/i&gt;&lt;br&gt;Recibir POST /orders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submit-idem" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de idempotencia&lt;/i&gt;&lt;br&gt;¿Idempotency-Key presente y es un UUID?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="230" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="submit-e400k" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;400 Bad Request&lt;br&gt;no llega al caso de uso" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="270" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-n_idem" value="Middleware montado solo en POST /orders. La clave se graba en orders.clientorderid, en la misma transacción que la orden." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-valid" value="&lt;i style=&quot;font-size:10px&quot;&gt;Validación Zod&lt;/i&gt;&lt;br&gt;¿Pedido válido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="440" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-e400" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;400 Bad Request&lt;br&gt;no se graba" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-n_valid" value="Se valida: campos, tipos, size o amount pero no ambos, LIMIT con price, MARKET sin price" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-exists" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (caso de uso) + AccountReader, InstrumentRepository&lt;/i&gt;&lt;br&gt;¿Existen usuario e instrumento?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="590" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="submit-e404" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;404 Not Found&lt;br&gt;no se graba" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="650" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-ars" value="&lt;i style=&quot;font-size:10px&quot;&gt;Order (dominio)&lt;/i&gt;&lt;br&gt;¿BUY o SELL sobre ARS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="840" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422a" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;no se graba" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="870" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-pcache" value="&lt;i style=&quot;font-size:10px&quot;&gt;Cache (Valkey)&lt;/i&gt;&lt;br&gt;Solo MARKET: leer el último close en Valkey (TTL 60 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="450" y="1030" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-pdb" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;Si no está o Valkey falla: leer el último close de marketdata y guardarlo en Valkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="1160" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-price" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (caso de uso)&lt;/i&gt;&lt;br&gt;Resolver precio:&lt;br&gt;MARKET = último close&lt;br&gt;LIMIT = price enviado&lt;br&gt;CASH_IN / CASH_OUT = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="450" y="1290" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="submit-nomd" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (caso de uso)&lt;/i&gt;&lt;br&gt;¿MARKET sin marketdata?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="1460" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422b" value="&lt;i style=&quot;font-size:10px&quot;&gt;Middleware de errores&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;no se graba" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="1500" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-qty" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderSizing (dominio)&lt;/i&gt;&lt;br&gt;Resolver cantidad: size, o parte entera de amount / precio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">

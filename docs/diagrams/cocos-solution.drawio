  <diagram id="search" name="Flow: search instruments">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="search-title" value="Flow: search instruments (GET /instruments?q=&amp;amp;limit=&amp;amp;offset=)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="search-subtitle" value="Each color shows the component that runs the step. Search by ticker or name, case- and accent-insensitive, with pagination and the latest closing price." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="search-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;Receive GET /instruments?q=&amp;amp;limit=&amp;amp;offset=" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search-hasq" value="&lt;i style=&quot;font-size:10px&quot;&gt;Zod validation&lt;/i&gt;&lt;br&gt;q present and not empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="230" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="search-e400" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;400 Bad Request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="270" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search-norm" value="&lt;i style=&quot;font-size:10px&quot;&gt;Zod validation&lt;/i&gt;&lt;br&gt;Normalize q (trim) and limit (default 20, maximum 100)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search-hit" value="&lt;i style=&quot;font-size:10px&quot;&gt;Cache (Valkey)&lt;/i&gt;&lt;br&gt;Result in Valkey for that text?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="490" y="530" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="search-okc" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;200 OK with the stored result" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="960" y="570" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search-n_hit" value="Key built from the normalized search text, limit and offset. If Valkey fails, it is treated as a miss and PostgreSQL is queried." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="search-query" value="&lt;i style=&quot;font-size:10px&quot;&gt;InstrumentRepository&lt;/i&gt;&lt;br&gt;Query instruments with unaccent(ticker or name) ILIKE unaccent('%q%')&lt;br&gt;(case- and accent-insensitive)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="720" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="search-sort" value="&lt;i style=&quot;font-size:10px&quot;&gt;InstrumentRepository (ORDER BY)&lt;/i&gt;&lt;br&gt;Sort: exact ticker match first, then ticker alphabetically" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="870" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search-md" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;Add the latest close from marketdata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="search-subtitle" value="Each color shows the component that runs the step. Search by ticker or name, case- and accent-insensitive, with pagination and the latest closing price. Responses are cached for 5 minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />

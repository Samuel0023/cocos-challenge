        <mxCell id="local-tests" value="Tests (Vitest + Supertest)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1020" y="990" width="260" height="80" as="geometry" />

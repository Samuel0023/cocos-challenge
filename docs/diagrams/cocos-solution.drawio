<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="build_drawio_en.py" version="24.7.17" type="device">
  <diagram id="aws" name="AWS architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="aws-title" value="AWS architecture: reference deployment, not part of the deliverable" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aws-subtitle" value="The API is the only component we own, and the event consumer runs inside the same process. Secrets Manager exists only in the infrastructure." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="aws-ecs" value="ECS Fargate · task cocos-api" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="360" height="540" as="geometry" />
        </mxCell>
        <mxCell id="aws-client" value="Client&lt;br&gt;(Postman / REST Client)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-alb" value="Application Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="310" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-rds" value="Amazon RDS for PostgreSQL&lt;br&gt;public schema: users, instruments, orders, marketdata&lt;br&gt;analytics schema: order_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1160" y="160" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="aws-valkey" value="Amazon ElastiCache for Valkey&lt;br&gt;latest close (TTL 60 s) and searches (TTL 5 min)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="1160" y="320" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-sns" value="Amazon SNS&lt;br&gt;topic order-events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1160" y="420" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-sqs" value="Amazon SQS&lt;br&gt;queue order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1580" y="420" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-secrets" value="AWS Secrets Manager&lt;br&gt;database credential" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-secnote" value="ECS injects it from the task definition. The API never calls Secrets Manager: it always reads the credential from environment variables." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-prom" value="Prometheus" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="800" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-grafana" value="Grafana" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="680" y="920" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-obsnote" value="Observability: a requirement added by the candidate, not by Cocos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="960" y="800" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws-awsnote" value="Reference deployment: not part of the deliverable. Locally, AWS_ENABLED=false writes events to the log instead of SNS." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="440" height="80" as="geometry" />
        </mxCell>

          <mxGeometry x="680" y="920" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aws-obsnote" value="Observabilidad: requisito agregado por el candidato, no por Cocos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

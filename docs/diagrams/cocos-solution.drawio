        <mxCell id="aws-e8" value="INSERT into analytics.order_events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-consumer" target="aws-rds">

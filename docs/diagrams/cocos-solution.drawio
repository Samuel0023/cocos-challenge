        <mxCell id="local-a_api" value="API cocos-api (Node.js en la máquina), puerto 3000&lt;br&gt;se inicia con make dev&lt;br&gt;lee la credencial de la base de variables de entorno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="local-laneA">

        </mxCell>
        <mxCell id="aws-awsnote" value="Despliegue de referencia: no forma parte del entregable. En local, AWS_ENABLED=false escribe los eventos en el log en lugar de SNS." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

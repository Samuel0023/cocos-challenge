          <mxGeometry x="2160" y="630" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_prom" value="Prometheus" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2160" y="940" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hex-x_sqs" value="Amazon SQS&lt;br&gt;queue order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">

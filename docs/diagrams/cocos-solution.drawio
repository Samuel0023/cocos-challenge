  <diagram id="portfolio" name="Flow: portfolio">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="portfolio-title" value="Flow: portfolio (GET /users/:userId/portfolio)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-subtitle" value="Each color shows the component that runs the step. Balances and positions are derived from FILLED orders; LIMIT reservations in NEW are subtracted from availability." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;Receive GET /users/:userId/portfolio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-exists" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (use case) + AccountReader&lt;/i&gt;&lt;br&gt;Does the user exist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-e404" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;404 Not Found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-cash" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Query pesos: sum of FILLED orders&lt;br&gt;(CASH_IN + SELL × price − CASH_OUT − BUY × price)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-avail" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Subtract reservations (LIMIT BUY in NEW: size × price)&lt;br&gt;= available pesos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="570" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-pos" value="&lt;i style=&quot;font-size:10px&quot;&gt;AccountReader&lt;/i&gt;&lt;br&gt;Query positions per instrument:&lt;br&gt;net quantity of FILLED orders (BUY − SELL)&lt;br&gt;weighted average cost of FILLED purchases" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="700" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-drop" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (use case)&lt;/i&gt;&lt;br&gt;Discard positions with quantity ≤ 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="850" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-mdc" value="&lt;i style=&quot;font-size:10px&quot;&gt;Cache (Valkey)&lt;/i&gt;&lt;br&gt;Read the latest close and previousClose per instrument from Valkey (TTL 60 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="330" y="960" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-md" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;If missing or Valkey fails: read them from marketdata and store them in Valkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="1090" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-calc" value="&lt;i style=&quot;font-size:10px&quot;&gt;PositionValuation (domain, with Money)&lt;/i&gt;&lt;br&gt;Compute per position:&lt;br&gt;market value = quantity × close&lt;br&gt;total return % = (close − average cost) / average cost&lt;br&gt;daily return % = (close − previousClose) / previousClose" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="1220" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-total" value="&lt;i style=&quot;font-size:10px&quot;&gt;GetPortfolio (use case)&lt;/i&gt;&lt;br&gt;Total value = peso balance + sum of market values" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="1390" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-ok" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;200 OK with totalValue, availableCash, positions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="1500" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-note" value="Expected result for user 1:&lt;br&gt;balance 753,000.00; available 627,500.00; PAMP 40, METR 500; total value 904,784.00" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="880" y="1220" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-fleg" value="Components" style="swimlane;whiteSpace=wrap;html=1;startSize=30;container=1;collapsible=0;rounded=0;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1280" y="110" width="300" height="380" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-fl0" value="Inbound adapter (Express)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="portfolio-fleg">
          <mxGeometry x="20" y="40" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="portfolio-fl1" value="Application (use case)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="portfolio-fleg">
          <mxGeometry x="20" y="80" width="260" height="30" as="geometry" />

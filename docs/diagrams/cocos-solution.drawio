          <mxGeometry x="40" y="420" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancel-commit" value="&lt;i style=&quot;font-size:10px&quot;&gt;UnitOfWork&lt;/i&gt;&lt;br&gt;COMMIT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="cancel-tx">

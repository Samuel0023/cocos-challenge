        <mxCell id="aws-e2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-alb" target="aws-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aws-e3" value="SQL (pg), transaction&lt;br&gt;with per-user lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.1333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-api" target="aws-rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aws-e4" value="cache; on failure,&lt;br&gt;read from PostgreSQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-api" target="aws-valkey">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aws-e5" value="publishes order.created / order.cancelled&lt;br&gt;after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.8667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-api" target="aws-sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aws-e6" value="subscription" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=default;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-sns" target="aws-sqs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

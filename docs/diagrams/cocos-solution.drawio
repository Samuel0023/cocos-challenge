        </mxCell>
        <mxCell id="search-sort" value="&lt;i style=&quot;font-size:10px&quot;&gt;InstrumentSearchRepository (ORDER BY)&lt;/i&gt;&lt;br&gt;Sort: exact ticker match first, then ticker prefix, then the rest by ticker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="search-md" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;Add the latest close from marketdata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

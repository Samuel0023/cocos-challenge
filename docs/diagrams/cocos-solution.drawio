        </mxCell>
        <mxCell id="consumer-rec" value="&lt;i style=&quot;font-size:10px&quot;&gt;RecordOrderEvent (caso de uso)&lt;/i&gt;&lt;br&gt;Registrar el evento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="830" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="consumer-ins" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderEventStore (PostgreSQL)&lt;/i&gt;&lt;br&gt;INSERT INTO analytics.order_events ... ON CONFLICT (event_id) DO NOTHING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="940" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-n_ins" value="Clave única sobre event_id: un evento repetido no graba nada." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">

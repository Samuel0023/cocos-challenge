  <diagram id="submit" name="Flow: submit order">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="submit-title" value="Flow: submit order (POST /orders)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="submit-subtitle" value="Each color shows the component that runs the step. Earlier validations persist nothing; the funds decision and the insert happen in a single transaction." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="submit-start" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;Receive POST /orders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submit-idem" value="&lt;i style=&quot;font-size:10px&quot;&gt;Idempotency middleware&lt;/i&gt;&lt;br&gt;Idempotency-Key present and a UUID?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="230" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="submit-e400k" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;400 Bad Request&lt;br&gt;does not reach the use case" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="260" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-n_idem" value="Middleware mounted only on POST /orders. The key is stored in orders.clientorderid, in the same transaction as the order." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-valid" value="&lt;i style=&quot;font-size:10px&quot;&gt;Zod validation&lt;/i&gt;&lt;br&gt;Valid request?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-e400" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;400 Bad Request&lt;br&gt;nothing is stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="430" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-n_valid" value="Validated: fields, types, size or amount but not both, LIMIT with price, MARKET without price" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-exists" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (use case) + AccountReader, InstrumentRepository&lt;/i&gt;&lt;br&gt;Do the user and instrument exist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="570" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="submit-e404" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;404 Not Found&lt;br&gt;nothing is stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="630" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-ars" value="&lt;i style=&quot;font-size:10px&quot;&gt;Order (domain)&lt;/i&gt;&lt;br&gt;BUY or SELL on ARS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="820" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422a" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;nothing is stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="830" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-pcache" value="&lt;i style=&quot;font-size:10px&quot;&gt;Cache (Valkey)&lt;/i&gt;&lt;br&gt;MARKET only: read the latest close from Valkey (TTL 60 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="450" y="970" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-pdb" value="&lt;i style=&quot;font-size:10px&quot;&gt;MarketDataRepository&lt;/i&gt;&lt;br&gt;If missing or Valkey fails: read the latest close from marketdata and store it in Valkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="1100" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-price" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (use case)&lt;/i&gt;&lt;br&gt;Resolve price:&lt;br&gt;MARKET = latest close&lt;br&gt;LIMIT = submitted price&lt;br&gt;CASH_IN / CASH_OUT = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="450" y="1230" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="submit-nomd" value="&lt;i style=&quot;font-size:10px&quot;&gt;SubmitOrder (use case)&lt;/i&gt;&lt;br&gt;MARKET without marketdata?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="1400" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422b" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;nothing is stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="1430" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-qty" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderSizing (domain)&lt;/i&gt;&lt;br&gt;Resolve quantity: size, or integer part of amount / price" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="450" y="1590" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-zero" value="&lt;i style=&quot;font-size:10px&quot;&gt;OrderSizing (domain)&lt;/i&gt;&lt;br&gt;Quantity = 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="1720" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422c" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;nothing is stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="1730" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="submit-okdup" value="&lt;i style=&quot;font-size:10px&quot;&gt;Express controller&lt;/i&gt;&lt;br&gt;201 Created with the already stored order&lt;br&gt;(no new order is created)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1280" y="2920" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="submit-e422d" value="&lt;i style=&quot;font-size:10px&quot;&gt;Error middleware&lt;/i&gt;&lt;br&gt;422 Unprocessable Entity&lt;br&gt;Idempotency-Key used with a different body" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">

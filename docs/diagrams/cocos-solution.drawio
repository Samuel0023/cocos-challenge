        </mxCell>
        <mxCell id="consumer-recv" value="&lt;i style=&quot;font-size:10px&quot;&gt;Consumidor de eventos SQS&lt;/i&gt;&lt;br&gt;ReceiveMessage en order-events-queue&lt;br&gt;(long polling)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer-msgs" value="&lt;i style=&quot;font-size:10px&quot;&gt;Consumidor de eventos SQS&lt;/i&gt;&lt;br&gt;¿Llegaron mensajes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">
          <mxGeometry x="500" y="550" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="consumer-parse" value="&lt;i style=&quot;font-size:10px&quot;&gt;Consumidor de eventos SQS&lt;/i&gt;&lt;br&gt;Parsear el evento: eventId y type&lt;br&gt;(order.created / order.cancelled)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcce6;strokeColor=#cc0066;" vertex="1" parent="1">

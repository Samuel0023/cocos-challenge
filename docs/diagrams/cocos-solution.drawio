        <mxCell id="cancel-title" value="Flow: cancel order (POST /orders/:orderId/cancel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">

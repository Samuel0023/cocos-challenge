        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "order_events_queue_backlog",
          "legendFormat": "messages"
        }
      ]
    }
  ],
  "templating": {
